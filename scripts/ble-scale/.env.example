# ── ColocOS ───────────────────────────────────────────────────────────────
COLOCOS_API_URL=http://localhost/api
COLOCOS_DEVICE_KEY=colocos_scale_device_key
# Optionnel : force la pesée sur un profil précis (sinon appariement par poids ±3 kg)
COLOCOS_USER_ID=

# ── Balance ───────────────────────────────────────────────────────────────
# Filtre optionnel : adresse MAC de la Mi Scale 2 (format AA:BB:CC:DD:EE:FF)
SCALE_MAC_ADDRESS=

# ── Jarvis Runner (optionnel) ─────────────────────────────────────────────
# Si renseigné, chaque pesée est aussi poussée vers Jarvis Runner
JARVIS_API_URL=
JARVIS_INTEGRATION_KEY=
