# ─────────────────────────────────────────────────────────────────────────────
# ColocOS — variables de la stack Docker
# Copier en `.env` à la racine :  cp .env.docker.example .env
# (le fichier .env racine est lu par docker compose, pas par l'application)
# ─────────────────────────────────────────────────────────────────────────────

# ── Domaine / HTTPS ───────────────────────────────────────────────────────────
# Nom d'hôte servi par Caddy. `localhost` → certificat interne, accessible en
# https://localhost. Sur le Wi-Fi, mettre le nom mDNS de la machine
# (ex. colocos.local) ou son IP pour que les téléphones atteignent l'app.
DOMAIN=localhost

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=colocos
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=colocos_db
# Port publié sur l'hôte (le backend de dev s'y connecte)
POSTGRES_PORT=5433

# ── API ───────────────────────────────────────────────────────────────────────
# Secrets JWT : 32 caractères minimum (générer avec `openssl rand -hex 32`)
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_another_openssl_rand_hex_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Clés « machine » (appareils sans session) — 32 caractères conseillés
# Balance connectée : header de POST /api/profile/weigh-in
SCALE_DEVICE_KEY=replace_with_openssl_rand_hex_16
# Pont Jarvis Runner : header de POST /api/integrations/jarvis/workout
JARVIS_INTEGRATION_KEY=replace_with_openssl_rand_hex_16
# Borne NFC Hybrid-Pay : header X-Terminal-Secret de POST /api/finance/settle-nfc
TERMINAL_SECRET=replace_with_openssl_rand_hex_16
# Code à fournir pour créer un compte (POST /api/auth/register)
INVITE_CODE=choose-a-long-invite-code

# ── Emails d'invitation (Resend) ──────────────────────────────────────────────
# Optionnelles : sans clé, l'API journalise le lien d'approbation et le code
# généré dans la console serveur (mode démo / local).
RESEND_API_KEY=
# Expéditeur vérifié chez Resend (domaine à configurer côté Resend)
MAIL_FROM=ColocOS <noreply@example.com>
# Destinataire des demandes d'accès (administrateur de la coloc)
ADMIN_EMAIL=
# URL de Jarvis Runner (optionnel)
JARVIS_API_URL=

# Origine autorisée par CORS (utile seulement si le front est servi ailleurs)
FRONTEND_URL=http://localhost

# ── Frontend / PWA ────────────────────────────────────────────────────────────
# Laisser /api : les appels passent par Caddy (même origine, pas de CORS)
VITE_API_URL=/api

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Générer une paire : npx web-push generate-vapid-keys
# Sans clés, l'API démarre mais n'envoie aucune notification.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@colocos.local

# ── Divers ────────────────────────────────────────────────────────────────────
TZ=Europe/Paris
EXPIRY_ALERT_THRESHOLD_DAYS=7
SPOONACULAR_API_KEY=

# ── Outils (profil « tools ») ─────────────────────────────────────────────────
PGADMIN_EMAIL=admin@colocos.local
PGADMIN_PASSWORD=change-me-pgadmin
PGADMIN_PORT=5050
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379
