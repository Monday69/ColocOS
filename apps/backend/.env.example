# ColocOS — backend en développement (npm run dev), copier en apps/backend/.env
# Base lancée avec : docker compose up -d db
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://colocos:change-me-strong-password@localhost:5433/colocos_db?schema=public

# 32 caractères minimum chacun (openssl rand -hex 32)
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_another_openssl_rand_hex_32

FRONTEND_URL=http://localhost:5173

# Optionnels en développement (obligatoires en production)
SCALE_DEVICE_KEY=dev_scale_device_key
JARVIS_INTEGRATION_KEY=dev_jarvis_integration_key
TERMINAL_SECRET=
INVITE_CODE=

# ── Emails d'invitation (Resend) ──────────────────────────────────────────────
# Optionnelles : sans clé, l'API journalise le lien d'approbation et le code
# généré dans la console serveur (mode démo / local).
RESEND_API_KEY=
# Expéditeur vérifié chez Resend (domaine à configurer côté Resend)
MAIL_FROM=ColocOS <noreply@example.com>
# Destinataire des demandes d'accès (administrateur de la coloc)
ADMIN_EMAIL=

# Optionnels
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SPOONACULAR_API_KEY=
JARVIS_API_URL=
