// ─────────────────────────────────────────────────────────────────────────────
// ColocOS — Prisma Schema
// ERD validé + extensions shopping_list + activity_log
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum StorageType {
  fridge
  freezer
  pantry
  cabinet
}

enum Unit {
  g
  kg
  ml
  L
  unit
}

enum ExpenseCategory {
  groceries
  utilities
  rent
  other
}

enum ActivityAction {
  ITEM_ADDED
  ITEM_REMOVED
  ITEM_UPDATED
  ITEM_MOVED
  ITEM_CONSUMED_PARTIAL
  EXPENSE_CREATED
  EXPENSE_SETTLED
  RECIPE_COOKED
  SHOPPING_ITEM_ADDED
  SHOPPING_ITEM_CHECKED
  USER_JOINED
}

enum ShoppingItemStatus {
  pending
  checked
  purchased
}

// ─────────────────────────────────────────
// USERS
// ─────────────────────────────────────────

model User {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(255)
  password   String   // bcrypt hash
  avatarUrl  String?  @map("avatar_url")
  colorHex   String   @default("#6366F1") @map("color_hex") @db.Char(7)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  badgeId      String?  @unique @map("badge_id") @db.VarChar(100) 

  /// Hash bcrypt du code PIN à 4 chiffres (sélecteur de profils)
  pinHash       String?  @map("pin_hash")

  // ── Authentification modulable (identifiant + PIN + lien magique NFC) ─────
  /// Identifiant court de connexion (`USERNAME_PIN`) — unique, optionnel
  username      String?   @unique @db.VarChar(40)
  /// Mode d'authentification exigé à la sélection du profil
  authMode      AuthMode  @default(AUTO_DEVICE) @map("auth_mode")
  /// Jeton du badge NFC (UUID v4) — régénérable, révocable
  nfcToken      String?   @unique @map("nfc_token") @db.VarChar(64)

  // ── Profil nutritionnel & biométrie ───────────────────────────────────────
  birthDate     DateTime?     @map("birth_date") @db.Date
  heightCm      Float?        @map("height_cm")
  weightKg      Float?        @map("weight_kg")
  /// "M" | "F" — influence la constante de Mifflin-St Jeor
  gender        String?       @db.Char(1)
  /// Facteur d'activité : 1.2 (sédentaire) → 1.9 (très actif)
  activityLevel Float         @default(1.2) @map("activity_level")
  nutritionGoal NutritionGoal @default(MAINTENANCE) @map("nutrition_goal")

  // Relations
  ownedItems       Item[]          @relation("ItemOwner")
  expensesPaid     Expense[]       @relation("ExpensePayer")
  expenseSplits    ExpenseSplit[]
  transactionsFrom Transaction[]   @relation("TransactionFrom")
  transactionsTo   Transaction[]   @relation("TransactionTo")
  shoppingItems    ShoppingItem[]  @relation("ShoppingItemAdder")
  activityLogs     ActivityLog[]
  pushSubscriptions PushSubscription[]
  favoriteRecipes  FavoriteRecipe[]
  cookedMeals      MealPlan[]       @relation("MealPlanCook")
  customRecipes    CustomRecipe[]
  meals            Meal[]           @relation("MealOwner")
  profile          UserProfile?
  nutritionLogs    NutritionLog[]
  weighIns         WeighIn[]

  @@map("users")
}

// ─────────────────────────────────────────
// WEB PUSH — SOUSCRIPTIONS PWA
// ─────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("push_subscriptions")
}

// ─────────────────────────────────────────
// DIGITAL TWIN — STORAGE ZONES
// ─────────────────────────────────────────

model StorageZone {
  id              String      @id @default(uuid()) @db.Uuid
  meshId          String      @unique @map("mesh_id") @db.VarChar(100)
  label           String      @db.VarChar(100)
  type            StorageType
  capacityLiters  Decimal?    @map("capacity_liters") @db.Decimal(6, 2)

  // Coordonnées 3D du centroïde du mesh (pour tooltips, raycast assist)
  positionX       Float?      @map("position_x")
  positionY       Float?      @map("position_y")
  positionZ       Float?      @map("position_z")

  // Hiérarchie : une porte contient des étagères
  parentZoneId    String?     @map("parent_zone_id") @db.Uuid
  parentZone      StorageZone?  @relation("ZoneHierarchy", fields: [parentZoneId], references: [id])
  childZones      StorageZone[] @relation("ZoneHierarchy")

  // Relations
  items           Item[]

  @@map("storage_zones")
}

// ─────────────────────────────────────────
// SMART INVENTORY — ITEMS
// ─────────────────────────────────────────

model Item {
  id            String      @id @default(uuid()) @db.Uuid
  barcode       String?     @db.VarChar(50)
  name          String      @db.VarChar(255)
  brand         String?     @db.VarChar(100)
  quantity      Decimal     @db.Decimal(8, 2)
  unit          Unit        @default(unit)
  /// Quantité au moment de l'ajout au frigo — base de la jauge de niveau.
  /// `quantity` joue le rôle de quantité COURANTE (source de vérité unique).
  initialQuantity Float     @default(1) @map("initial_quantity")
  /// Renseigné quand le stock tombe à 0 : l'item sort du twin (soft-delete)
  consumedAt    DateTime?   @map("consumed_at") @db.Timestamptz
  expiryDate    DateTime?   @map("expiry_date") @db.Date
  imageUrl      String?     @map("image_url")
  nutriscore    String?     @db.Char(1) // A, B, C, D, E
  isShared      Boolean     @default(true) @map("is_shared")
  // Empêche de re-notifier chaque jour le même produit (alerte J+1)
  expiryNotified Boolean    @default(false) @map("expiry_notified")

  // ── Nutrition (Open Food Facts, pour 100 g / 100 ml) ──────────────────────
  calories      Float?      // kcal
  proteins      Float?      // g
  carbohydrates Float?      // g
  fat           Float?      // g
  fiber         Float?      // g
  /// Classification NOVA 1 → 4 (degré de transformation)
  novaGroup     Int?        @map("nova_group")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  // Foreign keys
  storageZoneId String      @map("storage_zone_id") @db.Uuid
  storageZone   StorageZone @relation(fields: [storageZoneId], references: [id])

  ownerId       String?     @map("owner_id") @db.Uuid
  owner         User?       @relation("ItemOwner", fields: [ownerId], references: [id])

  @@index([barcode])
  @@index([expiryDate])
  @@index([storageZoneId])
  @@map("items")
}

// ─────────────────────────────────────────
// CACHE OPENFOODFACTS
// ─────────────────────────────────────────

model OffCache {
  barcode   String   @id @db.VarChar(50)
  data      Json     // Payload complet OFF (JSONB)
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz

  @@map("off_cache")
}

// ─────────────────────────────────────────
// RECIPE ENGINE — CACHE MARMITON
// ─────────────────────────────────────────

model Recipe {
  id          String   @id @default(uuid()) @db.Uuid
  sourceUrl   String   @unique @map("source_url")
  title       String   @db.VarChar(255)
  imageUrl    String?  @map("image_url")
  ingredients Json     // [{ name: string, quantity: number, unit: string }]
  steps       Json     // [{ order: number, text: string }]
  prepTimeMin Int?     @map("prep_time_min")
  scrapedAt   DateTime @default(now()) @map("scraped_at") @db.Timestamptz

  @@map("recipes")
}

// ─────────────────────────────────────────
// FINANCE — TRICOUNT-LIKE
// ─────────────────────────────────────────

model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  description String          @db.VarChar(255)
  amount      Decimal         @db.Decimal(10, 2)
  category    ExpenseCategory @default(other)
  receiptUrl  String?         @map("receipt_url")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz

  // Qui a payé
  paidById    String          @map("paid_by") @db.Uuid
  paidBy      User            @relation("ExpensePayer", fields: [paidById], references: [id])

  // Répartition
  splits      ExpenseSplit[]

  @@map("expenses")
}

model ExpenseSplit {
  id          String   @id @default(uuid()) @db.Uuid
  shareAmount Decimal  @map("share_amount") @db.Decimal(10, 2)
  isSettled   Boolean  @default(false) @map("is_settled")

  expenseId   String   @map("expense_id") @db.Uuid
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@map("expense_splits")
}

model Transaction {
  id           String   @id @default(uuid()) @db.Uuid
  amount       Decimal  @db.Decimal(10, 2)
  note         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  fromUserId   String   @map("from_user_id") @db.Uuid
  fromUser     User     @relation("TransactionFrom", fields: [fromUserId], references: [id])

  toUserId     String   @map("to_user_id") @db.Uuid
  toUser       User     @relation("TransactionTo", fields: [toUserId], references: [id])

  @@index([fromUserId])
  @@index([toUserId])
  @@map("transactions")
}

// ─────────────────────────────────────────
// SHOPPING LIST
// ─────────────────────────────────────────

model ShoppingList {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @default("Liste de courses") @db.VarChar(100)
  isArchived  Boolean        @default(false) @map("is_archived")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  items       ShoppingItem[]

  @@map("shopping_lists")
}

model ShoppingItem {
  id             String             @id @default(uuid()) @db.Uuid
  name           String             @db.VarChar(255)
  quantity       Decimal            @default(1) @db.Decimal(8, 2)
  unit           Unit               @default(unit)
  barcode        String?            @db.VarChar(50)
  status         ShoppingItemStatus @default(pending)
  note           String?            @db.VarChar(255)
  // Suggestion automatique si stock < seuil
  isAutoSuggested Boolean           @default(false) @map("is_auto_suggested")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz

  shoppingListId String             @map("shopping_list_id") @db.Uuid
  shoppingList   ShoppingList       @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  addedById      String?            @map("added_by_id") @db.Uuid
  addedBy        User?              @relation("ShoppingItemAdder", fields: [addedById], references: [id])

  @@map("shopping_items")
}

// ─────────────────────────────────────────
// ACTIVITY LOG — Audit trail complet
// ─────────────────────────────────────────

model ActivityLog {
  id         String         @id @default(uuid()) @db.Uuid
  action     ActivityAction
  // Payload flexible : { itemId, zoneName, amount, ... }
  meta       Json?
  // IP + user agent pour audit
  ipAddress  String?        @map("ip_address") @db.VarChar(45)
  userAgent  String?        @map("user_agent")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  userId     String?        @map("user_id") @db.Uuid
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

// ─────────────────────────────────────────
// NUTRITION — objectifs personnalisés
// ─────────────────────────────────────────

enum NutritionGoal {
  MAINTENANCE
  LEAN_BULK
  CUT
  HIGH_PROTEIN
}

// ─────────────────────────────────────────────────────────────────────────────
// Recettes : favoris par colocataire & semainier des repas
// ─────────────────────────────────────────────────────────────────────────────

model FavoriteRecipe {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Identifiant de recette du catalogue local (`riz-saute-soja`) ou Spoonacular
  recipeId  String   @map("recipe_id") @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, recipeId])
  @@index([userId])
  @@map("favorite_recipes")
}

enum MealSlot {
  LUNCH
  DINNER
}

model MealPlan {
  id         String   @id @default(uuid()) @db.Uuid
  date       DateTime @db.Date
  slot       MealSlot
  recipeId   String   @map("recipe_id") @db.VarChar(120)
  recipeName String   @map("recipe_name") @db.VarChar(160)
  cookId     String?  @map("cook_id") @db.Uuid
  cook       User?    @relation("MealPlanCook", fields: [cookId], references: [id], onDelete: SetNull)
  /// Colocataires présents à table (IDs) — `null` = toute la coloc
  attendeeIds Json?   @map("attendee_ids")
  /// Nombre de convives (repli : attendeeIds.length)
  servings    Int?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([date, slot])
  @@index([date])
  @@map("meal_plans")
}

/// Recette importée d'une page web (JSON-LD) ou saisie manuellement
model CustomRecipe {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(200)
  sourceUrl    String?  @map("source_url") @db.VarChar(500)
  imageUrl     String?  @map("image_url") @db.VarChar(500)
  prepTimeMin  Int?     @map("prep_time_min")
  cookTimeMin  Int?     @map("cook_time_min")
  servings     Int      @default(4)
  /// Tableau de chaînes : ["Étape 1", "Étape 2"]
  instructions Json
  /// Tableau d'objets : [{ name, quantity, unit }]
  ingredients  Json
  createdById  String   @map("created_by_id") @db.Uuid
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdById])
  @@map("custom_recipes")
}

// ─────────────────────────────────────────
// NUTRITION — REPAS ENREGISTRÉS (journal des macros)
// ─────────────────────────────────────────

model Meal {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  /// Copie de `createdAt` au format YYYY-MM-DD : requêtage journalier direct
  date          String   @db.Char(10)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  totalCalories Float    @default(0) @map("total_calories")
  totalProteins Float    @default(0) @map("total_proteins")
  totalCarbs    Float    @default(0) @map("total_carbs")
  totalFat      Float    @default(0) @map("total_fat")

  user  User?      @relation("MealOwner", fields: [userId], references: [id], onDelete: SetNull)
  items MealItem[]

  @@index([userId, date])
  @@index([date])
  @@map("meals")
}

model MealItem {
  id       String @id @default(uuid()) @db.Uuid
  mealId   String @map("meal_id") @db.Uuid
  name     String @db.VarChar(255)
  barcode  String? @db.VarChar(50)
  grams    Float
  calories Float
  proteins Float
  carbs    Float
  fat      Float

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@map("meal_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// PROFIL ATHLÈTE — authentification modulable, macros & pesées
// ─────────────────────────────────────────────────────────────────────────────

/// Mode de connexion du profil.
/// AUTO_DEVICE   : sélection du profil = session ouverte (tablette de cuisine)
/// PIN_ONLY      : code PIN seul
/// USERNAME_PIN  : identifiant + code PIN
enum AuthMode {
  AUTO_DEVICE
  PIN_ONLY
  USERNAME_PIN
}

/// Objectif sportif du profil (pilote le delta calorique et la répartition).
enum ProfileGoal {
  MAINTAIN
  BULK
  CUT
  CARB_LOAD
}

/// Biométrie + cibles journalières calculées (Mifflin-St Jeor × activité).
model UserProfile {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @unique @map("user_id") @db.Uuid
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm       Int         @map("height_cm")
  weightKg       Float       @map("weight_kg")
  birthDate      DateTime    @map("birth_date") @db.Date
  /// "M" | "F"
  sex            String      @db.Char(1)
  activityFactor Float       @default(1.55) @map("activity_factor")
  goal           ProfileGoal @default(MAINTAIN)
  targetKcal     Int         @map("target_kcal")
  targetProtein  Int         @map("target_protein")
  targetCarbs    Int         @map("target_carbs")
  targetFat      Int         @map("target_fat")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@map("user_profiles")
}

/// Consommation alimentaire journalière (macro-tracking temps réel).
model NutritionLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @db.VarChar(160)
  kcal       Float
  proteinG   Float    @map("protein_g")
  carbsG     Float    @map("carbs_g")
  fatG       Float    @map("fat_g")
  /// STOCK_ACTION | MEAL | MANUAL
  source     String   @db.VarChar(24)
  consumedAt DateTime @default(now()) @map("consumed_at") @db.Timestamptz

  @@index([userId, consumedAt])
  @@map("nutrition_logs")
}

/// Pesée (balance Xiaomi BLE ou saisie manuelle).
model WeighIn {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg     Float    @map("weight_kg")
  impedanceOhm Float?   @map("impedance_ohm")
  bodyFatPct   Float?   @map("body_fat_pct")
  muscleMassKg Float?   @map("muscle_mass_kg")
  /// BLE_SCALE | MANUAL
  source       String   @db.VarChar(24)
  measuredAt   DateTime @default(now()) @map("measured_at") @db.Timestamptz

  @@index([userId, measuredAt])
  @@map("weigh_ins")
}
